# Copy to .env.local (already gitignored) and fill in.
# Only read by scripts/sync-github.ts at build time — never sent to the browser.

# A classic or fine-grained personal access token. No special scopes needed
# for public data (public_repo read access is enough). Without this, the
# sync still works — 60 requests/hour instead of 5,000 — but the Developer
# Activity section on /dev/now and the whole /activity workspace (heatmap,
# streaks, most-active-repo insight) stay hidden, since GitHub only exposes
# contribution calendars through the authenticated GraphQL API. The
# /activity/timeline activity feed has no such requirement — it reads
# GitHub's public events endpoint, which needs no token.
GITHUB_TOKEN=

# Defaults to raahul4559 if unset — only needed to point the sync at a
# different account.
GITHUB_USERNAME=raahul4559
